--- a/crates/service/tests/paykit_live_test.rs
+++ b/crates/service/tests/paykit_live_test.rs
@@ -324,3 +324,98 @@ async fn upstream_live_commit_activate_replay_and_rollback_void(pool: PgPool) {
     paykit_pool.close().await;
     drop(harness);
 }
+
+#[sqlx::test(migrator = "marketplace_service::TEST_MIGRATOR")]
+#[ignore = "capture protocol-real upstream Paykit exchanges"]
+async fn capture_upstream_marketplace_exchanges(pool: PgPool) {
+    use marketplace_service::payments::PaykitLifecycleTarget;
+
+    let harness = live_harness();
+    let (app, seller, buyer) = live_parties(pool, &harness).await;
+    let client = live_client(&app);
+    let first_order = Uuid::parse_str("11111111-1111-4111-8111-111111111111").unwrap();
+    let prepared = client
+        .create_payment_request(
+            &seller.pubky,
+            &buyer.pubky,
+            first_order,
+            1,
+            50_000,
+            app.clock.now() + chrono::Duration::hours(1),
+            3_600,
+        )
+        .await
+        .unwrap();
+    let PaykitPrepared::Upstream {
+        invoice_id,
+        total_sats,
+        ..
+    } = prepared
+    else {
+        panic!("upstream prepare")
+    };
+    assert_eq!(
+        client
+            .create_payment_request(
+                &seller.pubky,
+                &buyer.pubky,
+                first_order,
+                1,
+                50_000,
+                app.clock.now() + chrono::Duration::hours(1),
+                3_600,
+            )
+            .await
+            .unwrap(),
+        prepared
+    );
+    let target = PaykitLifecycleTarget::Upstream {
+        creator: seller.pubky.clone(),
+    };
+    let activated = client
+        .activate_payment_request(&target, invoice_id, total_sats, 1)
+        .await
+        .unwrap();
+    assert_eq!(activated.invoice_id, invoice_id);
+    let (status, _) = client
+        .marketplace_payment_status(&seller.pubky, invoice_id, Some(activated.payment_deadline))
+        .await;
+    assert!(matches!(
+        status,
+        marketplace_service::payments::PaykitStatusOutcome::Undetected
+            | marketplace_service::payments::PaykitStatusOutcome::ActiveUndetected { .. }
+            | marketplace_service::payments::PaykitStatusOutcome::AcceptancePending { .. }
+    ));
+    let resolved = client
+        .resolve_payment_request(&target, invoice_id, "paid_manually", app.clock.now())
+        .await
+        .unwrap();
+    assert_eq!(resolved.status, reqwest::StatusCode::OK);
+    assert_eq!(resolved.resolved.unwrap().outcome, "paid_manually");
+
+    let second_order = Uuid::parse_str("22222222-2222-4222-8222-222222222222").unwrap();
+    let second = client
+        .create_payment_request(
+            &seller.pubky,
+            &buyer.pubky,
+            second_order,
+            1,
+            50_000,
+            app.clock.now() + chrono::Duration::hours(1),
+            3_600,
+        )
+        .await
+        .unwrap();
+    let PaykitPrepared::Upstream {
+        invoice_id: second_invoice,
+        ..
+    } = second
+    else {
+        panic!("upstream prepare")
+    };
+    let voided = client
+        .void_payment_request(&target, second_invoice, "not serialized upstream")
+        .await
+        .unwrap();
+    assert_eq!(voided.invoice_id, second_invoice);
+}
