# Config-parity list for hold / payment windows.
# Keys must match Config::from_env defaults (crates/service/src/config.rs)
# Values here are the code defaults. A deployment may set longer
# FIAT/BITCOIN overrides; the service honors any value ≥ 60.
#
# Do not put secrets in this file. Copy to `.env` locally if needed.

# Unbound leftover cancel (ordinary checkout.create does not hold stock).
CHECKOUT_HOLD_WINDOW_SECONDS=900

# PayPal bind hold. Default 10 minutes.
FIAT_PAYMENT_WINDOW_SECONDS=600

# Bitcoin bind hold; the same instant is Paykit expires_at (upstream: its
# activation-time deadline + 60 s once the request is active).
BITCOIN_PAYMENT_WINDOW_SECONDS=1800

# Largest accepted upstream Paykit prepare TTL (60..=86400 seconds).
PAYKIT_MAX_PREPARE_TTL_SECONDS=900

# Locks correlation window IS the hold window.
LOCKS_PAYMENT_WINDOW_SECONDS=3600

# Sandbox lock point (first transition out of awaiting_entitlement).
SANDBOX_PAYMENT_WINDOW_SECONDS=900

# Drop lock-at-claim, still acquired at checkout.create.
DROP_CLAIM_WINDOW_SECONDS=600

# Store mode: marketplace or single_seller; unset derives from the seller pin.
STORE_MODE=

# Optional one-time setup code for an unclaimed single-seller store.
STORE_CLAIM_TOKEN=

# Maximum age of the grant-minted session used to claim the store.
STORE_CLAIM_SESSION_MAX_AGE_SECONDS=900

# Sealing keys: names only, never values. Deployment tooling that applies
# configuration declaratively must keep every one of them, because every row
# sealed under a key stops opening when the key is lost.
# PRIV_DATA_KEY_ENCRYPTION_KEY=
# PRIV_DATA_KEY_ENCRYPTION_KEY_PREVIOUS=

# FX rate feed (single-seller mode only: STORE_MODE=single_seller or
# STORE_SELLER_PUBKY set; marketplace mode stays pinned to Blocktank and
# refuses custom values).
# Default endpoints quote every fiat the provider supports; a single Kraken
# `?pair=<PAIR>` or Bitstamp `/api/v2/ticker/btc<ccy>/` URL quotes one fiat
# only (commands, sampling, bind, and GET /health `fx_source.currencies` match
# that set). BTC and SAT stay supported on every provider.
# Providers and default fiat coverage (omit pair/path suffix for all fiats):
#   blocktank: USD, EUR, CHF, GBP, JPY, CAD, AUD
#   kraken (/0/public/Trades): USD, EUR, CHF, GBP, JPY, CAD, AUD
#   coinbase (/v2/exchange-rates?currency=BTC): USD, EUR, CHF, GBP, JPY, CAD, AUD
#   mempool (/api/v1/prices): USD, EUR, CHF, GBP, JPY, CAD, AUD
#   bitstamp (/api/v2/ticker/): USD, EUR, GBP
# Blocktank and Mempool refuse query parameters on FX_FEED_URL; Coinbase on
# api.coinbase.com requires `?currency=BTC` (an empty query defaults to USD on
# Coinbase and is refused at boot; custom Coinbase-format hosts may omit the
# query when they default to BTC).
# PAYKIT_MARKETPLACE_CONTRACT=multi_asset needs PAYKIT_SERVER_API=upstream and USD in
# the feed's supported currencies (multi-currency feed or a USD single-pair Kraken
# `?pair=XXBTZUSD` / Bitstamp `/api/v2/ticker/btcusd/`). A non-USD single-pair URL
# is for PAYKIT_MARKETPLACE_CONTRACT=legacy / the Paykit fork only.
# EU_FENCE_ENABLED=true or any nuanced EU-27 country in REGION_MODES requires EUR in
# the feed's supported currencies for C4 annual-limit and re-confirmation conversions
# (blocked-only and open-only region modes do not require EUR).
# FX_FEED_PROVIDER=blocktank
# FX_FEED_URL=https://api1.blocktank.to/api/fx/rates/btc
