# Config-parity list for hold / payment windows.
# Keys must match Config::from_env defaults (crates/service/src/config.rs)
# Values here are the code defaults. A deployment may set longer
# FIAT/BITCOIN overrides; the service honors any value ≥ 60.
#
# Do not put secrets in this file. Copy to `.env` locally if needed.

# Unbound leftover cancel (ordinary checkout.create does not hold stock).
CHECKOUT_HOLD_WINDOW_SECONDS=900

# PayPal bind hold. Default 10 minutes.
FIAT_PAYMENT_WINDOW_SECONDS=600

# Bitcoin bind hold; the same instant is Paykit expires_at (upstream: its
# activation-time deadline + 60 s once the request is active).
BITCOIN_PAYMENT_WINDOW_SECONDS=1800

# Largest accepted upstream Paykit prepare TTL (60..=86400 seconds).
PAYKIT_MAX_PREPARE_TTL_SECONDS=900

# Locks correlation window IS the hold window.
LOCKS_PAYMENT_WINDOW_SECONDS=3600

# Sandbox lock point (first transition out of awaiting_entitlement).
SANDBOX_PAYMENT_WINDOW_SECONDS=900

# Drop lock-at-claim, still acquired at checkout.create.
DROP_CLAIM_WINDOW_SECONDS=600

# Sealing keys: names only, never values. Deployment tooling that applies
# configuration declaratively must keep every one of them, because every row
# sealed under a key stops opening when the key is lost.
# PRIV_DATA_KEY_ENCRYPTION_KEY=
# PRIV_DATA_KEY_ENCRYPTION_KEY_PREVIOUS=
